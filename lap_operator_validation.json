  "theory": {
    "functional": "E_xc = integral f(rho_alpha,rho_beta,sigma_aa,sigma_ab,sigma_bb,lapl_alpha,lapl_beta) dr",
    "spin_sigma_gradient_alpha": "A_alpha = 2*f_sigma_aa*grad(rho_alpha) + f_sigma_ab*grad(rho_beta)",
    "spin_sigma_gradient_beta": "A_beta = 2*f_sigma_bb*grad(rho_beta) + f_sigma_ab*grad(rho_alpha)",
    "spin_ao_operator": "V^s_mn = sum_g w_g [C_s*phi_m*phi_n + A_s dot (grad(phi_m)*phi_n + phi_m*grad(phi_n)) + B_s*(phi_m*lap(phi_n) + phi_n*lap(phi_m) + 2*grad(phi_m) dot grad(phi_n))]",
    "rks_factors": {
      "vrho": "(C_alpha + C_beta)/2",
      "vsigma": "(f_sigma_aa + f_sigma_ab + f_sigma_bb)/4",
      "vlapl": "(B_alpha + B_beta)/2",
      "vtau": 0,
      "spin_density_matrices": "P_alpha = P_beta = P_total/2",
      "total_rks_matrix": "(V_alpha + V_beta)/2; common PySCF scalars already encode this averaging, so do not apply another half factor"
    },
    "reference_projection": "V_ref_mn = sum_g w_g*phi[g,m]*vxc_ref[g]*phi[g,n], no spin factor",
    "symmetric_dm_convention": "delta_E_xc = Tr(V_RKS delta_P_total) for a full symmetric AO density matrix",
    "operator_loss": "||S^-1/2 (V_pred - V_ref) S^-1/2||_F^2 / n_AO",
    "theory_review": "operator_theory independently agreed with the spin and RKS factors"
  },
